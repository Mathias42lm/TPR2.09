{% extends 'base.html.twig' %}

{% block title %}Visualisation du blog{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Blog des messages</h1>
    <a href="{{ path('blog_save') }}" class="btn btn-secondary mb-4">Ajouter un message</a>

    {% for m in messages %}
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">{{ m.pseudo }}</h5>
                {# ATTENTION : Le filtre |raw rend cette page vulnérable aux scripts injectés #}
                <div class="card-text">
                    {{ m.message | raw }}
                </div>
            </div>
        </div>
    {% else %}
        <p>Aucun message pour le moment.</p>
    {% endfor %}
</div>
{% endblock %}